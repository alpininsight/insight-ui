# ======= #
# General #
# ======= #

DEBUG=True
LOG_LEVEL=WARNING
APP_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
SERVER_LOG_LEVEL=WARNING
ACCESS_LOG_ENABLED=False
LOG_FORMAT=console

SECRET_KEY=django-insecure-test-key-not-for-production

# ========== #
# Deployment #
# ========== #

# Disables 'Rosetta' and 'Tailwind-CLI',
# If you want to set this to False, remember to set USE_TAILWIND_CLI to False as well
IS_PROD=False
SERVICE_NAMESPACE=alpininsight
SERVICE_NAME=insight-ui
PLATFORM_NAMESPACE=demo
DEPLOYMENT_ENVIRONMENT=local
DEPLOYMENT_LANE=develop
DEPLOYMENT_SLOT=green
PUBLIC_BASE_URL=http://localhost:8000
INSIGHT_UI_USE_MINIFIED_ASSETS=False
INSIGHT_UI_CDN_ENABLED=False
INSIGHT_UI_CDN_BASE_URL=https://cdn.alpininsight.ai
INSIGHT_UI_CDN_PREFIX=insight-ui
INSIGHT_UI_CDN_VERSION=latest
INSIGHT_UI_JS_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,insight-ui.demo.alpininsight.ai
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://insight-ui.demo.alpininsight.ai
USE_X_FORWARDED_HOST=True
# Set this only behind a trusted reverse proxy / ingress
TRUST_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ======== #
# Tailwind #
# ======== #

USE_TAILWIND_CLI=False
