{
  "name": "insight-ui",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript tests for Insight UI components",
  "type": "module",
  "scripts": {
    "build:js": "node scripts/build-static-assets.mjs",
    "check:js-build": "node scripts/build-static-assets.mjs --check",
    "build:tailwind": "USE_TAILWIND_CLI=True uv run manage.py tailwind build --force --no-minify",
    "build:static": "node scripts/build-static-assets.mjs",
    "build:static-all": "npm run build:tailwind && npm run build:static",
    "check:tailwind-sync": "node scripts/check-tailwind-theme-sync.mjs",
    "check:static-build": "npm run check:tailwind-sync && node scripts/build-static-assets.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "terser": "^5.49.1",
    "vitest": "^4.1.10"
  }
}
