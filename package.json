{
  "name": "insight-ui",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript tests for Insight UI components",
  "type": "module",
  "scripts": {
    "build:js": "node scripts/build-static-assets.mjs",
    "check:js-build": "node scripts/build-static-assets.mjs --check",
    "build:static": "node scripts/build-static-assets.mjs",
    "check:static-build": "node scripts/build-static-assets.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "clean-css": "^5.3.3",
    "jsdom": "^28.1.0",
    "terser": "^5.47.1",
    "vitest": "^4.0.18"
  }
}
