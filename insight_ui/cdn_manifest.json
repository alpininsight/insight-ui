{
  "$comment": "Required-verification SUBSET, not the publish list. What gets published is decided by the release rollout (cdn_asset_globs in .github/workflows/*.yml over insight_ui/static/insight_ui) — that stays the single source of truth for publishing. This file lists only the template-required insight-ui assets that must be smoke-verified BEFORE runtime CDN delivery is enabled (issue #314). Full URL = <cdn_base_url>/<cdn_prefix>/<version>/<path>. See docs/cdn-delivery.md.",
  "cdn_base_url": "https://cdn.alpininsight.ai",
  "cdn_prefix": "insight-ui",
  "url_template": "https://cdn.alpininsight.ai/insight-ui/{version}/{path}",
  "required": [
    {
      "path": "css/tailwind.min.css",
      "loaded_by": "base.html (INSIGHT_UI.stylesheet)",
      "condition": "always",
      "must_contain_selectors": [
        "lg:block",
        "lg:hidden",
        "lg:flex-row",
        "lg:flex-nowrap",
        "lg:w-fit",
        "lg:py-3",
        "lg:bg-transparent",
        "lg:border-none",
        "lg:shadow-none"
      ]
    },
    { "path": "js/insight-ui-init.min.js", "loaded_by": "base.html", "condition": "always" },
    { "path": "js/insight-ui-utils.min.js", "loaded_by": "base.html", "condition": "always" },
    { "path": "js/insight-ui-state.min.js", "loaded_by": "base.html", "condition": "always" },
    { "path": "js/insight-ui-websocket.min.js", "loaded_by": "base.html", "condition": "always" },
    { "path": "js/insight-ui-debug.min.js", "loaded_by": "base.html", "condition": "always" },
    { "path": "js/insight-ui-toc-generator.min.js", "loaded_by": "base.html", "condition": "always" }
  ],
  "conditional": [
    {
      "path": "css/prism.min.css",
      "loaded_by": "base.html",
      "condition": "INSIGHT_UI.load_prism = True"
    },
    {
      "path": "js/insight-ui-demo-sandbox.min.js",
      "loaded_by": "component demo templates",
      "condition": "demo/sandbox pages only"
    }
  ]
}
