msgid "Describes the radio button group and the individual radio elements."
msgstr "Beschreibt die Radio-Button-Gruppe und die einzelnen Radio-Elemente."

#: .\insight_ui\component_details\parameter_context.py:721
#: .\insight_ui\component_details\parameter_context.py:790
msgid "A text label displayed above the radio elements."
msgstr ""
"Ein beschreibender Text, welcher über den Radio-Elementen angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:723
#: .\insight_ui\component_details\parameter_context.py:792
msgid "<b>True</b> if the radio elements should be displayed side by side."
msgstr ""
"<b>True</b>, wenn die Radio-Elemente nebeneinander angezeigt werden sollen."

#: .\insight_ui\component_details\parameter_context.py:732
#: .\insight_ui\component_details\parameter_context.py:801
msgid "The value of the currently selected radio button."
msgstr "Der Wert des aktuell ausgewählten Radio-Buttons."

#: .\insight_ui\component_details\parameter_context.py:737
#: .\insight_ui\component_details\parameter_context.py:806
msgid ""
"Name of the URL to which the request should be sent when clicking one of the"
" radio buttons."
msgstr ""
"Name der URL, an welche der Request beim Anklicken auf einen der Radio-"
"Button gesendet werden soll."

#: .\insight_ui\component_details\parameter_context.py:741
#: .\insight_ui\component_details\parameter_context.py:810
msgid "A string of query parameters to be sent along with the request."
msgstr ""
"Ein String von Such-Parametern, welche bei dem Request mit gesendet werden "
"sollen."

#: .\insight_ui\component_details\parameter_context.py:744
#: .\insight_ui\component_details\parameter_context.py:813
msgid "The ID of the HTML tag to be replaced when switching the radio button."
msgstr ""
"Die ID des HTML-Tags, welcher beim Wechseln des Radio-Buttons ausgetauscht "
"werden soll."

#: .\insight_ui\component_details\parameter_context.py:749
#: .\insight_ui\component_details\parameter_context.py:818
msgid ""
"Name of the JavaScript method to be executed when clicking one of the radio "
"buttons."
msgstr ""
"Name der JavaScript Methode, welche beim Anklicken auf einen der Radio-"
"Button ausgeführt werden soll."

#: .\insight_ui\component_details\parameter_context.py:756
#: .\insight_ui\component_details\parameter_context.py:825
msgid ""
"<b>True</b> if the group is inside a &lt;form&gt;. If <b>False</b> the group"
" gets its own &lt;form&gt;."
msgstr ""
"<b>True</b>, wenn sich die Gruppe in einer &lt;form&gt; befindet. Bei "
"<b>False</b> bekommt die Gruppe ihre eigene &lt;form&gt;."

#: .\insight_ui\component_details\parameter_context.py:776
#: .\insight_ui\component_details\parameter_context.py:1523
msgid "Optional icon displayed before the label."
msgstr "Optionales Icon, welches vor der Beschriftung angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:847
msgid "A text label displayed above the range slider."
msgstr ""
"Ein beschreibender Text, welcher über dem Range-Slider angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:848
msgid "The value of the range slider."
msgstr "Der Wert des Range-Sliders."

#: .\insight_ui\component_details\parameter_context.py:849
msgid "Smallest configurable value of the range slider."
msgstr "Kleinster einzustellender Wert des Range-Sliders."

#: .\insight_ui\component_details\parameter_context.py:850
msgid "Largest configurable value of the range slider."
msgstr "Größter einzustellender Wert des Range-Sliders."

#: .\insight_ui\component_details\parameter_context.py:852
msgid ""
"The size of the steps by which the value changes when moving the range "
"slider."
msgstr ""
"Die Größe der Schritte, um welche sich der Wert beim Bewegen des Range-"
"Sliders verändert."

#: .\insight_ui\component_details\parameter_context.py:854
msgid "<b>True</b> if the range slider should be disabled."
msgstr "<b>True</b>, wenn der Range-Slider deaktiviert sein soll."

#: .\insight_ui\component_details\parameter_context.py:855
msgid "A list of texts displayed as a legend below the slider."
msgstr ""
"Eine Liste von Texten, welche als Legende unter dem Slider angezeigt werden."

#: .\insight_ui\component_details\parameter_context.py:880
msgid "A text label displayed above the toggle button."
msgstr ""
"Ein  beschreibender Text, welcher über dem Toggle-Button angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:881
msgid "The value of the toggle button."
msgstr "Der Wert des Toggle-Buttons."

#: .\insight_ui\component_details\parameter_context.py:883
msgid ""
"<b>True</b> if the toggle button should look like a typical switch select."
msgstr ""
"<b>True</b>, wenn der Toggle-Button wie ein typischer Switch-Select aussehen"
" soll."

#: .\insight_ui\component_details\parameter_context.py:885
msgid "<b>True</b> if the toggle button should be selected."
msgstr "<b>True</b>, wenn der Toggle-Button ausgewählt sein soll."

#: .\insight_ui\component_details\parameter_context.py:886
msgid "<b>True</b> if the toggle button should be disabled."
msgstr "<b>True</b>, wenn der Toggle-Button deaktiviert sein soll."

#: .\insight_ui\component_details\parameter_context.py:888
msgid ""
"Name of the JavaScript method to be executed when the toggle button is "
"clicked."
msgstr ""
"Name der JavaScript Methode, welche beim Anklicken auf den Toggle-Button "
"ausgeführt werden soll."

#: .\insight_ui\component_details\parameter_context.py:911
#: .\insight_ui\component_details\parameter_context.py:940
msgid "A text label displayed above the select."
msgstr "Ein beschreibender Text, welcher über dem Select angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:912
#: .\insight_ui\component_details\parameter_context.py:945
msgid "List of values that can be selected."
msgstr "Liste von Werten, welche ausgewählt werden können."

#: .\insight_ui\component_details\parameter_context.py:916
msgid ""
"Value (the key value, if the options were passed as a dict) of the currently"
" selected option."
msgstr ""
"Wert (Der Key-Wert, falls die Optionen als Dict übergeben wurden) der "
"aktuell ausgewählten Option."

#: .\insight_ui\component_details\parameter_context.py:941
msgid "Maximum number of selectable options."
msgstr "Anzahl der maximal ausgewählten Optionen."

#: .\insight_ui\component_details\parameter_context.py:943
msgid "Show additional buttons for 'Select All' and 'Deselect All'."
msgstr ""
"Zusätzliche Buttons für 'Alle Auswählen' und 'Alle Abwählen' Buttons "
"anzeigen."

#: .\insight_ui\component_details\parameter_context.py:946
msgid "List of currently selected options."
msgstr "Liste der aktuell ausgewählten Optionen."

#: .\insight_ui\component_details\parameter_context.py:965
msgid ""
"Name of the URL to which the request should be sent when submitting a "
"message."
msgstr ""
"Name der URL, an welche der Request beim Absenden einer Nachricht gesendet "
"werden soll."

#: .\insight_ui\component_details\parameter_context.py:980
msgid "Message displayed in the alert."
msgstr "Angezeigte Nachricht im Alert."

#: .\insight_ui\component_details\parameter_context.py:982
msgid ""
"Type of the alert. Possible values are 'info', 'success', 'warning' and "
"'error'."
msgstr ""
"Typ des Alerts. Mögliche Werte sind 'info', 'success' (Erfolg), 'warning' "
"(Warnung) und 'error' (Fehler)."

#: .\insight_ui\component_details\parameter_context.py:985
msgid "Shows a button to close the alert at the end of the alert container."
msgstr ""
"Zeigt einen Button zum Schließen des Alerts am Ende des Alert-Containers an."

#: .\insight_ui\component_details\parameter_context.py:997
msgid "List of buttons displayed at the bottom of the dialog."
msgstr ""
"Liste von Buttons, welche um unteren Ende des Dialogs angezeigt werden."

#: .\insight_ui\component_details\parameter_context.py:1005
msgid ""
"Describes the importance of the button (purely visual). Possible values are:"
" 'primary' and 'secondary'.."
msgstr ""
"Beschreibt die Wichtigkeit des Buttons (rein visuell). Mögliche Werte sind: "
"'primary' und 'secondary'."

#: .\insight_ui\component_details\parameter_context.py:1009
msgid "Call a JavaScript function, e.g.: alert('Confirmed!')"
msgstr "Aufruf einer JavaScript Funktion, bspw.: alert('Confirmed!')"

#: .\insight_ui\component_details\parameter_context.py:1010
msgid "Closes the dialog on click."
msgstr "Schließt den Dialog beim Anklicken."

#: .\insight_ui\component_details\parameter_context.py:1019
msgid "Heading of the modal dialog."
msgstr "Überschrift des Modal Dialogs."

#: .\insight_ui\component_details\parameter_context.py:1020
msgid "Text displayed directly below the title."
msgstr "Text, welcher direkt unter dem Titel angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:1024
msgid ""
"Additional text displayed below the header, which itself consists of title "
"and description."
msgstr ""
"Zusätzlicher Text, welcher unter der Kopfzeile, bestehend aus Titel und "
"Beschreibung, angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:1038
msgid "Determines the popover object to be displayed on hover."
msgstr ""
"Bestimmt das Popover-Objekt, welches beim Hovern angezeigt werden soll."

#: .\insight_ui\component_details\parameter_context.py:1044
msgid ""
"Determines where the popover should be displayed relative to the element. "
"Possible values are: 'top', 'bottom', 'right', and 'left'."
msgstr ""
"Bestimmt, wo im Bezug auf das Element der Popover angezeigt werden soll. "
"Mögliche Werte sind: 'top' (darüber), 'bottom' (darunter), 'right' (rechts),"
" und 'left' (links)."

#: .\insight_ui\component_details\parameter_context.py:1051
msgid ""
"Shows an arrow at the edge of the popover pointing to the triggering object."
msgstr "Zeigt am Rand des Popovers einen Pfeil hin zum auslösenden Objekt an."

#: .\insight_ui\component_details\parameter_context.py:1066
msgid ""
"Shows a tooltip with the specified text when hovering over the element."
msgstr ""
"Zeigt beim Hovern über das Element einen Tooltip mit dem angegeben Text an."

#: .\insight_ui\component_details\parameter_context.py:1073
msgid ""
"Determines where the tooltip should be displayed relative to the element. "
"Possible values are: 'top', 'bottom', 'right', and 'left'."
msgstr ""
"Bestimmt, wo im Bezug auf das Element der Tooltip angezeigt werden soll. "
"Mögliche Werte sind: 'top' (darüber), 'bottom' (darunter), 'right' (rechts),"
" und 'left' (links)."

#: .\insight_ui\component_details\parameter_context.py:1080
msgid ""
"Shows an arrow at the edge of the tooltip pointing to the triggering object."
msgstr "Zeigt am Rand des Tooltips einen Pfeil hin zum auslösenden Objekt an."

#: .\insight_ui\component_details\parameter_context.py:1096
msgid ""
"Identifies this object as a code block and specifies the used language."
msgstr ""
"Identifiziert dieses Objekt als Code Block und die darin verwendete Sprache."

#: .\insight_ui\component_details\parameter_context.py:1102
msgid ""
"Displays the text as a hint for the user in the header of the code block."
msgstr ""
"Zeigt den Text als Hinweis für den Nutzer in der Kopfzeile des Code Blocks "
"an."

#: .\insight_ui\component_details\parameter_context.py:1114
msgid "First or older version of the text."
msgstr "Erste bzw. ältere Version des Textes."

#: .\insight_ui\component_details\parameter_context.py:1115
msgid "Second or newer version of the text."
msgstr "Zweite bzw. neuere Version des Textes."

#: .\insight_ui\component_details\parameter_context.py:1133
msgid "List of data entries."
msgstr "Liste der Dateneinträge."

#: .\insight_ui\component_details\parameter_context.py:1135
msgid "Latitude of the data entry."
msgstr "Breitengrad (Latitude) des Dateneintrags."

#: .\insight_ui\component_details\parameter_context.py:1136
msgid "Longitude of the data entry."
msgstr "Längengrad (Longitude) des Dateneintrags."

#: .\insight_ui\component_details\parameter_context.py:1137
msgid "Displayed as the heading in the popover of the data entry."
msgstr "Wird als Überschrift in dem Popover des Dateneintrags angezeigt."

#: .\insight_ui\component_details\parameter_context.py:1139
msgid "Displayed below the title in the popover of the data entry."
msgstr "Wird unter dem Titel im Popover des Dateneintrags angezeigt."

#: .\insight_ui\component_details\parameter_context.py:1142
msgid ""
"Used only for 'circle' data entries and defines the size/color of the "
"circle."
msgstr ""
"Wird nur für 'circle' Dateneinträge verwendet und definiert die Größe/Farbe "
"des Kreises."

#: .\insight_ui\component_details\parameter_context.py:1149
msgid "Datasets to be displayed on the map."
msgstr "Datensätze, welche auf der Karte dargestellt werden sollen."

#: .\insight_ui\component_details\parameter_context.py:1151
msgid "The name of the dataset, used internally for identification."
msgstr "Der Name des Datensatzes, wird intern zur Identifizierung verwendet."

#: .\insight_ui\component_details\parameter_context.py:1153
msgid ""
"How the data should be displayed. Possible values are: 'marker' and "
"'circle'."
msgstr ""
"Darstellungsweise der Daten. Mögliche Werte sind: 'marker' (Symbol) und "
"'circle' (Kreis)."

#: .\insight_ui\component_details\parameter_context.py:1161
msgid "Describes the map and the data to be displayed on it."
msgstr "Beschreibt die Karte und die darauf darzustellenden Daten."

#: .\insight_ui\component_details\parameter_context.py:1166
msgid "Starting position on the map when the page is loaded."
msgstr "Startposition auf der Karte beim Seitenaufruf."

#: .\insight_ui\component_details\parameter_context.py:1169
msgid "Zoom level on the map when the page is loaded."
msgstr "Zoom der Karte beim Seitenaufruf"

#: .\insight_ui\component_details\parameter_context.py:1175
msgid "Height of the map in 'rem'."
msgstr "Höhe der Karte in 'rem'."

#: .\insight_ui\component_details\parameter_context.py:1184
msgid "Information and data of the chart."
msgstr "Informationen und Daten des Diagramms."

#: .\insight_ui\component_details\parameter_context.py:1186
msgid "Displayed as the heading above the chart."
msgstr "Wird über dem Diagramm als Überschrift angezeigt."

#: .\insight_ui\component_details\parameter_context.py:1187
msgid "Label of the x-axis."
msgstr "Beschriftung der X-Achse."

#: .\insight_ui\component_details\parameter_context.py:1188
msgid "Names of the individual datasets."
msgstr "Namen der einzelnen Datensätze."

#: .\insight_ui\component_details\parameter_context.py:1189
msgid "The data of the individual datasets."
msgstr "Die Daten der einzelnen Datensätze."

#: .\insight_ui\component_details\parameter_context.py:1209
msgid "URL of the API endpoint for querying data."
msgstr "URL des API Endpunkts zum Abfragen der Daten."

#: .\insight_ui\component_details\parameter_context.py:1210
msgid "Interval of data retrieval in seconds."
msgstr "Intervall des Datenabrufs in Sekunden."

#: .\insight_ui\component_details\parameter_context.py:1211
#: .\insight_ui\component_details\parameter_context.py:1225
msgid "Optional initial content."
msgstr "Optionaler, initialer Inhalt."

#: .\insight_ui\component_details\parameter_context.py:1224
msgid "URL of the WebSocket API endpoint."
msgstr "URL des Websocket-API Endpunkts."

#: .\insight_ui\component_details\parameter_context.py:1241
msgid ""
"Name of the URL to which the request for loading more elements should be "
"send."
msgstr ""
"Name der URL, an welche der Request zum Laden weitere Elemente gesendet "
"werden soll."

#: .\insight_ui\component_details\parameter_context.py:1244
msgid "List of already loaded elements."
msgstr "Liste der bereits geladenen Elemente."

#: .\insight_ui\component_details\parameter_context.py:1249
msgid ""
"<b>True</b>, new entries are loaded as soon as the specified scroll "
"threshold is exceeded. <b>False</b>, at the end of the list a button to "
"fetch more entries is shown instead."
msgstr ""
"<b>True</b>, neue Einträge werden geladen, sobald der angegebenen Threshold "
"beim Scrollen überschritten wird. <b>False</b>, am Ende der Liste wird "
"stattdessen ein Button zum Abfragen weiterer Einträge angezeigt."

#: .\insight_ui\component_details\parameter_context.py:1256
msgid ""
"The pixel threshold for loading more elements (only when "
"<b>auto_fetch=False</b>)."
msgstr ""
"Der Pixel-Schwellenwert für das Laden weiterer Elemente (nur wenn "
"<b>auto_fetch=False</b>)."

#: .\insight_ui\component_details\parameter_context.py:1269
msgid "A Django-generated pagination object for the current page."
msgstr "Ein von Django erzeugtes Pagination-Objekt der aktuellen Seite."

#: .\insight_ui\component_details\parameter_context.py:1271
msgid "List of adjacent pages."
msgstr "Liste der benachbarten Seiten."

#: .\insight_ui\component_details\parameter_context.py:1281
msgid "Describes the table and the data to be displayed in it."
msgstr "Beschreibt die Tabelle und die darin darzustellenden Daten."

#: .\insight_ui\component_details\parameter_context.py:1283
msgid "Heading of the table."
msgstr "Überschrift der Tabelle."

#: .\insight_ui\component_details\parameter_context.py:1284
msgid "Displayed when no data entries are present ('rows=[]')."
msgstr "Wird angezeigt, wenn keine Dateneinträge vorhanden sind ('rows=[]')."

#: .\insight_ui\component_details\parameter_context.py:1285
msgid "List of headings for the individual columns."
msgstr "Liste der Überschriften für die einzelnen Spalten."

#: .\insight_ui\component_details\parameter_context.py:1286
msgid "List of data for the individual rows."
msgstr "Liste der Daten für die einzelnen Zeilen."

#: .\insight_ui\component_details\parameter_context.py:1301
msgid ""
"Name of the URL to which the request should be sent when changing a filter."
msgstr ""
"Name der URL, an welche der Request beim Ändern eines Filters gesendet "
"werden soll."

#: .\insight_ui\component_details\parameter_context.py:1306
msgid ""
"ID of the HTML container whose content should be replaced on response (e.g. "
"a list of filtered data)."
msgstr ""
"ID des HTML-Containers, dessen Inhalt beim Response ausgetauscht werden soll"
" (z.B. eine gefilterte Liste von Daten)."

#: .\insight_ui\component_details\parameter_context.py:1312
msgid ""
"<b>True</b> if the selected filter values should be displayed in the URL."
msgstr ""
"<b>True</b>, wenn die ausgewählten Filterwerte in der URL angezeigt werden "
"sollen."

#: .\insight_ui\component_details\parameter_context.py:1315
msgid "Definition of the individual filters."
msgstr "Definition der einzelnen Filter."

#: .\insight_ui\component_details\parameter_context.py:1316
msgid "<b>True</b> if the filters should be arranged in a column."
msgstr "<b>True</b>, wenn die Filter übereinander angeordnet sein sollen."

#: .\insight_ui\component_details\parameter_context.py:1320
msgid ""
"Contains the currently selected values of the individual filters to restore "
"them after the request."
msgstr ""
"Enthält die aktuell ausgewählten Werte der einzelnen Filter für die "
"Wiederherstellung nach dem Request."

#: .\insight_ui\component_details\parameter_context.py:1335
msgid ""
"Name of the URL to which the request should be sent when submitting the "
"search."
msgstr ""
"Name der URL, an welche der Request beim Absenden der Suche gesendet werden "
"soll."

#: .\insight_ui\component_details\parameter_context.py:1341
msgid ""
"<b>True</b> if the search bar should be displayed without a button and "
"smaller."
msgstr ""
"<b>True</b>, wenn die Suchleiste ohne Button und kleiner angezeigt werden "
"soll."

#: .\insight_ui\component_details\parameter_context.py:1344
msgid "Optional value automatically displayed in the text field."
msgstr "Optionaler Wert, der automatisch im Textfeld angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:1363
msgid "Describes an image displayed as background for the title and subtitle."
msgstr ""
"Beschreibt ein Bild, welches als Hintergrund für den Titel und Untertitel "
"angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:1366
#: .\insight_ui\component_details\parameter_context.py:1455
msgid "URL to the image resource."
msgstr "URL zur Bild-Ressource."

#: .\insight_ui\component_details\parameter_context.py:1370
#: .\insight_ui\component_details\parameter_context.py:1459
msgid ""
"Displayed alternative text used for screen readers if the image cannot be "
"loaded."
msgstr ""
"Angezeigter Alternativtext für Screenreader, falls das Bild nicht geladen "
"werden kann."

#: .\insight_ui\component_details\parameter_context.py:1379
msgid "List of buttons displayed at the bottom edge of the card."
msgstr "Liste von Buttons, welche am unteren Rand der Karte angezeigt werden."

#: .\insight_ui\component_details\parameter_context.py:1387
msgid ""
"Describes the importance of the button (purely visual). Possible values are:"
" 'primary' and 'secondary'."
msgstr "URL, welche beim Anklicken auf den Button aufgerufen werden soll."

#: .\insight_ui\component_details\parameter_context.py:1397
msgid "Heading of the card."
msgstr "Überschrift der Karte."

#: .\insight_ui\component_details\parameter_context.py:1398
msgid "Optional subtitle displayed directly below the title."
msgstr "Optionaler Untertitel, welcher direkt unter dem Titel angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:1402
msgid ""
"Text content of the card. Displayed below the title or subtitle if there is "
"one."
msgstr "Textinhalt der Karte. Wird unter dem Titel bzw. Untertitel angezeigt."

#: .\insight_ui\component_details\parameter_context.py:1417
#: .\insight_ui\component_details\parameter_context.py:1505
msgid "Data to be displayed within the carousel (freely definable)."
msgstr ""
"Daten, welche innerhalb des Karussells angezeigt werden sollen (frei "
"definierbar)."

#: .\insight_ui\component_details\parameter_context.py:1422
#: .\insight_ui\component_details\parameter_context.py:1471
msgid ""
"<b>True</b> if the current page should be displayed in the bottom right "
"corner."
msgstr ""
"<b>True</b>, wenn in der unteren rechten Ecke die aktuelle Seite angezeigt "
"werden soll."

#: .\insight_ui\component_details\parameter_context.py:1428
#: .\insight_ui\component_details\parameter_context.py:1477
msgid ""
"<b>True</b> if a simple pagination should be displayed below the carousel "
"content."
msgstr ""
"<b>True</b>, wenn unter dem Karussell-Inhalt eine einfache Pagination "
"angezeigt werden soll."

#: .\insight_ui\component_details\parameter_context.py:1434
#: .\insight_ui\component_details\parameter_context.py:1483
msgid ""
"<b>True</b> if the carousel should iterate through the content "
"automatically."
msgstr ""
"<b>True</b>, wenn das Karussell selbständig durch den Inhalt iterieren soll."

#: .\insight_ui\component_details\parameter_context.py:1437
msgid "Number of 'carousel_items' per page."
msgstr "Anzahl an 'carousel_items' pro Seite."

#: .\insight_ui\component_details\parameter_context.py:1447
msgid "Images to be displayed within the carousel."
msgstr "Bilder, welche innerhalb des Karussells angezeigt werden sollen."

#: .\insight_ui\component_details\parameter_context.py:1452
msgid ""
"Optional description of the image displayed at the top edge of the image."
msgstr ""
"Optionale Beschreibung des Bildes, welche am oberen Rand des Bildes "
"angezeigt wird."

#: .\insight_ui\component_details\parameter_context.py:1486
msgid "Number of images per page."
msgstr "Anzahl der Bilder pro Seite."

#: .\insight_ui\component_details\parameter_context.py:1499
msgid "Rotation speed of the carousel."
msgstr "Drehgeschwindigkeit des Karussells."

#: .\insight_ui\component_details\parameter_context.py:1500
msgid "Vertical tilt of the carousel towards the camera."
msgstr "Vertikale Neigung des Karussells zur Kamera."

#: .\insight_ui\component_details\parameter_context.py:1502
msgid "<b>True</b> if all cards should face the camera at all times."
msgstr ""
"<b>True</b>, wenn alle Karten immer in Richtung der Kamera ausgerichtet sein"
" sollen."

#: .\insight_ui\component_details\parameter_context.py:1533
msgid "Configuration of the radio group for switching the view type."
msgstr "Konfiguration der Radio-Group, zum Wechseln der Ansichtsart."

#: .\insight_ui\component_details\parameter_context.py:1549
msgid ""
"Unique tag ID for identifying the element in JavaScript (required for "
"switching the view)."
msgstr ""
"Eindeutige Tag-ID für die Identifizierung des Elements im JavaScript (wird "
"für den Wechsel der Ansicht benötigt)."

#: .\insight_ui\component_details\parameter_context.py:1552
msgid "Data to be displayed."
msgstr "Daten, welche angezeigt werden sollen."

#: .\insight_ui\component_details\parameter_context.py:1554
msgid "Name of the currently selected view type."
