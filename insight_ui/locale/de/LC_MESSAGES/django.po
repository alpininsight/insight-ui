msgid "Explore by category"
msgstr "Nach Kategorien entdecken"

#: .\insight_ui\templates\insight_ui\index.html:303
msgid "From layout primitives to complex data components — find what you need."
msgstr "Von Layout-Bausteinen bis zu komplexen Datenkomponenten: finde, was du brauchst."

